{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flashinfer-npu.local/schemas/attention-capability-manifest-v1.json",
  "title": "FlashInfer-NPU Attention capability manifest",
  "type": "object",
  "required": ["schema_version", "generated_at", "profiles"],
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string", "minLength": 1},
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "schema_version",
          "profile_id",
          "backend",
          "environment",
          "status",
          "numerics_policy",
          "rules",
          "evidence"
        ],
        "properties": {
          "schema_version": {"const": 1},
          "profile_id": {"type": "string", "minLength": 1},
          "backend": {
            "enum": ["ascendc_aot", "ascendc_jit", "aclnn", "reference"]
          },
          "environment": {"type": "object"},
          "status": {"enum": ["draft", "protocol", "functional", "optimized"]},
          "numerics_policy": {"type": "object"},
          "rules": {"type": "array", "minItems": 1, "items": {"type": "object"}},
          "evidence": {"type": "array", "items": {"type": "object"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
